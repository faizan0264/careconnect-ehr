# Root Gitignore for CareConnect EHR Monorepo

# Local tool bundles (portable Maven)
maven/
apache-maven-*/

# Node dependencies & builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local

# Java / Maven build output
target/
**/target/
*.class
*.jar
*.war
*.ear

# IDE & Editor files
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
**/.vscode/
.classpath
.project
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Scratch & Temporary
scratch/
*.tmp
