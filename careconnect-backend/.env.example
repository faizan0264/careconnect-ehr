# ==============================================================================
# CareConnect EHR - Spring Boot Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# Active Spring Profile (default: h2 in-memory)
SPRING_PROFILES_ACTIVE=default

# Allowed CORS Origins
CARECONNECT_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://careconnect-ehr.vercel.app
